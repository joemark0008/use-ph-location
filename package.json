{
  "name": "use-ph-location",
  "version": "1.0.0",
  "description": "React hook for Philippine location selection with region, province, city/municipality, and barangay data",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "data"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "prepublish": "npm run build",
    "fetch-data": "node scripts/fetch-data.js",
    "update-data": "npm run fetch-data"
  },
  "keywords": [
    "react",
    "hooks",
    "philippines",
    "location",
    "region",
    "province",
    "city",
    "municipality",
    "barangay",
    "address"
  ],
  "author": "JOE MARK GIMENO",
  "license": "MIT",
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@types/jest": "^29.0.0",
    "@types/react": "^18.0.0",
    "@types/node": "^18.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^4.9.0",
    "react": "^18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/use-ph-location"
  },
  "bugs": {
    "url": "https://github.com/yourusername/use-ph-location/issues"
  },
  "homepage": "https://github.com/yourusername/use-ph-location#readme"
}
